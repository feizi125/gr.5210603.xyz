{
  "name": "zhuifeng-muzhe",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "none"
  },
  "vars": {
    "ADMIN_PASS": "feizi521"
  },
  "kv_namespaces": [
    { "binding": "DATA", "id": "a93fe656579247cdb2f74f99a2f2cea5" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GUESTBOOK", "class_name": "Guestbook" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Guestbook"] }
  ],
  "routes": [
    { "pattern": "gr.5210603.xyz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
